pipeline {
    agent any

    stages {

        stage('Clone') {
    steps {
        git branch: 'main', url: 'https://github.com/bitzroma/Jenkins.git'
    }
}

        stage('Build') {
            steps {
                sh 'cd src/main/java && javac Main.java'
            }
        }

        stage('Run') {
            steps {
                sh 'cd src/main/java && java Main'
            }
        }
    }
}
